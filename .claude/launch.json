{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "surfslop",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "surfslop", "serve", "--lan"],
      "port": 7873
    },
    {
      "name": "surfslop-public",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "surfslop", "serve", "--public", "--hostname", "surf.example.com"],
      "port": 7874
    }
  ]
}
